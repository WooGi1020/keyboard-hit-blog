{
  "name": "keboard_hit_blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n velite,next -c cyan,green \"velite --watch\" \"next dev\"",
    "build": "velite && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "velite && tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.29",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "velite": "^0.4.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{mdx,css,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ]
}
